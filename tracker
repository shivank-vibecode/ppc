  { id: 81, workstream: "Team & Process", task: "Perfect retargeting strategy — segment pixel audiences by stage", owner: "Naomi + Team", deadline: "", status: "Not Started", source: "Jul 14 — Marketing Post-Mortem" },
  { id: 82, workstream: "Team & Process", task: "Book MQL campaigns — 12-month for proven markets (Botswana, Nigeria), shorter for tests", owner: "Rakshit", deadline: "", status: "Not Started", source: "Jul 14 — Marketing Post-Mortem" },
  { id: 83, workstream: "Team & Process", task: "Assess $5M VIP deal for Video & Demand Gen — review performance through July", owner: "Shivank", deadline: "2026-07-31", status: "Not Started", source: "Jun 30 — Project Phoenix Q3" },
  { id: 84, workstream: "Team & Process", task: "Share Q3 budget forecast (Jul-Aug) with leadership for alignment", owner: "Shivank", deadline: "2026-07-03", status: "Not Started", source: "Jun 30 — Project Phoenix Q3" },
  { id: 85, workstream: "Team & Process", task: "Propose name and visual identity for the new 'engine' initiative", owner: "Team", deadline: "", status: "Not Started", source: "Jul 22 — GTM AI Agent Strategy" },
];

let currentWorkstream = "All";
let currentStatus = "All";
let currentSearch = "";
let expandedId = null;

function getStats() {
  const s = { total: tasks.length };
  STATUS_OPTIONS.forEach(st => {
    s[st] = tasks.filter(t => t.status === st).length;
  });
  return s;
}

function getWorkstreamCounts() {
  const counts = {};
  WORKSTREAMS.slice(1).forEach(ws => {
    counts[ws] = tasks.filter(t => t.workstream === ws).length;
  });
  return counts;
}

function renderStats() {
  const stats = getStats();
  const row = document.getElementById('statsRow');
  row.innerHTML = '';
  STATUS_OPTIONS.forEach(st => {
    const c = STATUS_COLORS[st];
    const btn = document.createElement('button');
    btn.className = 'stat-btn' + (currentStatus === st ? ' active' : '');
    btn.style.color = c.text;
    btn.style.background = currentStatus === st ? c.bg : 'var(--bg-secondary)';
    btn.style.borderColor = currentStatus === st ? c.dot : 'var(--border-color)';
    btn.innerHTML = `<span class="count">${stats[st]}</span>${st}`;
    btn.onclick = () => {
      currentStatus = currentStatus === st ? "All" : st;
      renderAll();
    };
    row.appendChild(btn);
  });
  if (currentStatus !== "All") {
    const clearBtn = document.createElement('button');
    clearBtn.className = 'clear-filter-btn';
    clearBtn.textContent = 'Clear filter ✕';
    clearBtn.onclick = () => { currentStatus = "All"; renderAll(); };
    row.appendChild(clearBtn);
  }
}

function renderTabs() {
  const counts = getWorkstreamCounts();
  const tabs = document.getElementById('wsTabs');
  tabs.innerHTML = '';
  WORKSTREAMS.forEach(ws => {
    const btn = document.createElement('button');
    btn.className = 'ws-tab' + (currentWorkstream === ws ? ' active' : '');
    btn.textContent = ws !== "All" ? `${ws} (${counts[ws] || 0})` : ws;
    btn.onclick = () => { currentWorkstream = ws; renderAll(); };
    tabs.appendChild(btn);
  });
}

function statusBadgeHtml(status) {
  const c = STATUS_COLORS[status];
  return `<span class="status-badge" style="background:${c.bg};color:${c.text};">
    <span class="status-dot" style="background:${c.dot};"></span>${status}
  </span>`;
}

function getFiltered() {
  return tasks.filter(t => {
    if (currentWorkstream !== "All" && t.workstream !== currentWorkstream) return false;
    if (currentStatus !== "All" && t.status !== currentStatus) return false;
    if (currentSearch) {
      const q = currentSearch.toLowerCase();
      return t.task.toLowerCase().includes(q) ||
             t.owner.toLowerCase().includes(q) ||
             t.source.toLowerCase().includes(q);
    }
    return true;
  });
}

function updateStatus(id, newStatus) {
  const t = tasks.find(x => x.id === id);
  if (t) t.status = newStatus;
  renderAll();
}

function toggleExpand(id) {
  expandedId = expandedId === id ? null : id;
  renderTaskList();
}

function renderTaskList() {
  const filtered = getFiltered();
  const stats = getStats();
  document.getElementById('showingCount').textContent = `Showing ${filtered.length} of ${stats.total} tasks`;

  const list = document.getElementById('taskList');
  const empty = document.getElementById('emptyState');

  if (filtered.length === 0) {
    list.innerHTML = '';
    empty.style.display = 'block';
    return;
  }
  empty.style.display = 'none';

  list.innerHTML = filtered.map(t => {
    const isExpanded = expandedId === t.id;
    const statusButtons = STATUS_OPTIONS.map(st => {
      const c = STATUS_COLORS[st];
      const active = t.status === st;
      return `<button class="status-btn${active ? ' active' : ''}"
        style="color:${c.text};border-color:${active ? c.dot : 'var(--border-color)'};background:${active ? c.bg : 'transparent'};"
        onclick="event.stopPropagation(); updateStatus(${t.id}, '${st}')">${st}</button>`;
    }).join('');

    return `
      <div class="task-card${isExpanded ? ' expanded' : ''}" onclick="toggleExpand(${t.id})">
        <div class="task-title">${escapeHtml(t.task)}</div>
        <div class="task-meta-row">
          <span class="ws-badge">${escapeHtml(t.workstream)}</span>
          ${statusBadgeHtml(t.status)}
        </div>
        <div class="task-detail">
          <div class="detail-grid">
            <div><strong>Owner:</strong> ${escapeHtml(t.owner)}</div>
            <div><strong>Deadline:</strong> ${escapeHtml(t.deadline || "—")}</div>
            <div class="full"><strong>Source:</strong> ${escapeHtml(t.source)}</div>
          </div>
          <div class="status-btn-row">${statusButtons}</div>
        </div>
      </div>
    `;
  }).join('');
}

function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

function renderAll() {
  const stats = getStats();
  document.getElementById('subtitle').textContent =
    `${stats.total} tasks extracted from 30 days of recordings (Jun 22 – Jul 22, 2026)`;
  renderStats();
  renderTabs();
  renderTaskList();
}

document.getElementById('searchBox').addEventListener('input', (e) => {
  currentSearch = e.target.value;
  renderTaskList();
});

renderAll();
</script>
