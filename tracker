    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    border: 1px solid var(--border-color);
    background: transparent;
    cursor: pointer;
    transition: all 0.1s;
    font-family: inherit;
  }
  .status-btn.active { border-width: 2px; }
  .empty-state {
    text-align: center;
    padding: 40px 0;
    color: var(--text-secondary);
    font-size: 14px;
