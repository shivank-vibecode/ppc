      {status}
    </span>
  );
}

export default function PlaudTaskTracker() {
  const [tasks, setTasks] = useState(() => {
    return INITIAL_TASKS;
  });
  const [filter, setFilter] = useState("All");
  const [statusFilter, setStatusFilter] = useState("All");
  const [search, setSearch] = useState("");
  const [expandedId, setExpandedId] = useState(null);

  const filtered = useMemo(() => {
    return tasks.filter((t) => {
      if (filter !== "All" && t.workstream !== filter) return false;
      if (statusFilter !== "All" && t.status !== statusFilter) return false;
      if (search) {
        const q = search.toLowerCase();
        return (
          t.task.toLowerCase().includes(q) ||
          t.owner.toLowerCase().includes(q) ||
          t.source.toLowerCase().includes(q)
        );
      }
      return true;
    });
  }, [tasks, filter, statusFilter, search]);

  const stats = useMemo(() => {
    const s = { total: tasks.length };
    STATUS_OPTIONS.forEach((st) => {
      s[st] = tasks.filter((t) => t.status === st).length;
    });
    return s;
  }, [tasks]);

  const updateStatus = (id, newStatus) => {
    setTasks((prev) => prev.map((t) => (t.id === id ? { ...t, status: newStatus } : t)));
  };

  const workstreamCounts = useMemo(() => {
    const counts = {};
    WORKSTREAMS.slice(1).forEach((ws) => {
      counts[ws] = tasks.filter((t) => t.workstream === ws).length;
    });
    return counts;
  }, [tasks]);

  return (
    <div style={{ fontFamily: "'Inter', -apple-system, BlinkMacSystemFont, sans-serif", maxWidth: 960, margin: "0 auto", padding: "24px 16px", color: "var(--text-color, #1a1a2e)" }}>
      {/* Header */}
      <div style={{ marginBottom: 28 }}>
        <h1 style={{ fontSize: 22, fontWeight: 700, margin: 0, letterSpacing: -0.5, color: "var(--text-color, #111)" }}>
          Plaud Task Tracker
        </h1>
        <p style={{ fontSize: 13, color: "var(--text-secondary, #666)", margin: "4px 0 0", lineHeight: 1.4 }}>
          {stats.total} tasks extracted from 30 days of recordings (Jun 22 – Jul 22, 2026)
        </p>
      </div>

      {/* Stats row */}
      <div style={{ display: "flex", gap: 8, marginBottom: 20, flexWrap: "wrap" }}>
        {STATUS_OPTIONS.map((st) => (
          <button
            key={st}
            onClick={() => setStatusFilter(statusFilter === st ? "All" : st)}
            style={{
              display: "flex", alignItems: "center", gap: 6,
              padding: "7px 14px", borderRadius: 8,
              border: statusFilter === st ? `2px solid ${statusColors[st].dot}` : "1px solid var(--border-color, #e2e2e8)",
              background: statusFilter === st ? statusColors[st].bg : "var(--bg-secondary, #fafafa)",
              cursor: "pointer", fontSize: 12, fontWeight: 600,
              color: statusColors[st].text,
              transition: "all 0.15s"
            }}
          >
            <span style={{ fontSize: 16, fontWeight: 700 }}>{stats[st]}</span>
            {st}
          </button>
        ))}
        {statusFilter !== "All" && (
          <button
            onClick={() => setStatusFilter("All")}
            style={{ padding: "7px 12px", borderRadius: 8, border: "1px solid var(--border-color, #e2e2e8)", background: "transparent", cursor: "pointer", fontSize: 12, color: "var(--text-secondary, #888)" }}
          >
            Clear filter ✕
          </button>
        )}
      </div>

      {/* Workstream tabs */}
      <div style={{ display: "flex", gap: 6, marginBottom: 12, flexWrap: "wrap" }}>
        {WORKSTREAMS.map((ws) => (
          <button
            key={ws}
            onClick={() => setFilter(ws)}
            style={{
              padding: "5px 12px", borderRadius: 6, fontSize: 11.5, fontWeight: filter === ws ? 700 : 500,
              border: "none",
              background: filter === ws ? "var(--text-color, #1a1a2e)" : "var(--bg-secondary, #f0f0f4)",
              color: filter === ws ? "var(--bg-color, #fff)" : "var(--text-secondary, #555)",
              cursor: "pointer", transition: "all 0.15s",
              whiteSpace: "nowrap"
            }}
          >
            {ws}{ws !== "All" ? ` (${workstreamCounts[ws] || 0})` : ""}
          </button>
        ))}
      </div>

      {/* Search */}
      <div style={{ marginBottom: 16 }}>
        <input
          type="text"
          placeholder="Search tasks, owners, or sources…"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          style={{
            width: "100%", padding: "9px 14px", borderRadius: 8,
            border: "1px solid var(--border-color, #ddd)", fontSize: 13,
            background: "var(--bg-color, #fff)", color: "var(--text-color, #111)",
            outline: "none", boxSizing: "border-box"
          }}
        />
      </div>

      {/* Showing count */}
      <p style={{ fontSize: 12, color: "var(--text-secondary, #888)", margin: "0 0 12px" }}>
        Showing {filtered.length} of {stats.total} tasks
      </p>

      {/* Task list */}
      <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
        {filtered.map((t) => {
          const isExpanded = expandedId === t.id;
          return (
            <div
              key={t.id}
              style={{
                border: "1px solid var(--border-color, #e8e8ee)",
                borderRadius: 10,
                padding: "12px 14px",
                background: "var(--bg-color, #fff)",
                cursor: "pointer",
                transition: "box-shadow 0.15s"
              }}
              onClick={() => setExpandedId(isExpanded ? null : t.id)}
            >
              <div style={{ display: "flex", alignItems: "flex-start", gap: 10 }}>
                <div style={{ flex: 1, minWidth: 0 }}>
                  <div style={{ fontSize: 13.5, fontWeight: 500, lineHeight: 1.45, color: "var(--text-color, #1a1a2e)" }}>
                    {t.task}
                  </div>
                  <div style={{ display: "flex", alignItems: "center", gap: 8, marginTop: 6, flexWrap: "wrap" }}>
                    <span style={{
                      fontSize: 10.5, fontWeight: 600, textTransform: "uppercase", letterSpacing: 0.6,
                      color: "var(--text-secondary, #888)", background: "var(--bg-secondary, #f3f3f7)",
                      padding: "2px 8px", borderRadius: 4
                    }}>
                      {t.workstream}
                    </span>
                    <StatusBadge status={t.status} />
                  </div>
                </div>
              </div>
              {isExpanded && (
                <div style={{ marginTop: 12, paddingTop: 10, borderTop: "1px solid var(--border-color, #eee)" }}>
                  <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "6px 16px", fontSize: 12.5, color: "var(--text-secondary, #555)" }}>
                    <div><span style={{ fontWeight: 600, color: "var(--text-color, #333)" }}>Owner:</span> {t.owner}</div>
                    <div><span style={{ fontWeight: 600, color: "var(--text-color, #333)" }}>Deadline:</span> {t.deadline || "—"}</div>
                    <div style={{ gridColumn: "1 / -1" }}><span style={{ fontWeight: 600, color: "var(--text-color, #333)" }}>Source:</span> {t.source}</div>
                  </div>
                  <div style={{ display: "flex", gap: 6, marginTop: 10, flexWrap: "wrap" }}>
                    {STATUS_OPTIONS.map((st) => (
                      <button
                        key={st}
                        onClick={(e) => { e.stopPropagation(); updateStatus(t.id, st); }}
                        style={{
                          padding: "4px 10px", borderRadius: 6, fontSize: 11, fontWeight: 600,
                          border: t.status === st ? `2px solid ${statusColors[st].dot}` : "1px solid var(--border-color, #ddd)",
                          background: t.status === st ? statusColors[st].bg : "transparent",
                          color: statusColors[st].text,
                          cursor: "pointer", transition: "all 0.1s"
                        }}
                      >
                        {st}
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      {filtered.length === 0 && (
        <div style={{ textAlign: "center", padding: "40px 0", color: "var(--text-secondary, #999)", fontSize: 14 }}>
          No tasks match your filters
        </div>
      )}
    </div>
  );
}
